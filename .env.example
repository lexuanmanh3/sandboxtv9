APP_NAME="Dailysky88 Topup"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dailysky88kr.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_MAX_FILES=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sandbox
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Mật khẩu khởi tạo tài khoản admin (chỉ dùng lần đầu chạy seeder)
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_EMAIL=admin@dailysky88kr.com

# Cảnh báo Telegram
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

