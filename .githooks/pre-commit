#!/bin/sh
# Pre-commit hook: chặn commit xóa các file critical cho Apache/Hostinger.
# Kích hoạt: git config core.hooksPath .githooks

CRITICAL_FILES="
public/index.php
public/.htaccess
.htaccess
server.php
"

ERROR=0
for file in $CRITICAL_FILES; do
    # Kiểm tra file có bị staged để xóa không (D = deleted)
    if git diff --cached --diff-filter=D --name-only | grep -qx "$file"; then
        echo "==============================================="
        echo "COMMIT BỊ CHẶN: file critical sắp bị xóa!"
        echo "==============================================="
        echo "File: $file"
        echo ""
        echo "File này BẮT BUỘC phải có trên Hostinger/Apache."
        echo "Xóa nó sẽ gây lỗi 404 toàn bộ site."
        echo ""
        echo "Nếu bạn THỰC SỰ muốn xóa, dùng:"
        echo "  git commit --no-verify -m \"...\""
        echo "==============================================="
        ERROR=1
    fi
done

if [ $ERROR -eq 1 ]; then
    exit 1
fi

exit 0
